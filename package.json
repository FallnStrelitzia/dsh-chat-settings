{
  "name": "@fallnstrelitzia/dsh-chat-settings",
  "version": "1.2.0",
  "type": "module",
  "description": "Per-conversation system prompt, context folding, sampling overrides and a runtime pure-chat mode, plus a dedicated empty chat workspace.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FallnStrelitzia/dsh-chat-settings.git"
  },
  "homepage": "https://github.com/FallnStrelitzia/dsh-chat-settings",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
